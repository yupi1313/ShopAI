# Copy to /opt/shopai/.env on the server (root:root, mode 600). Never commit the real file.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram numeric user id of the first admin (send /id to the bot, or ask @userinfobot)
ADMIN_TELEGRAM_ID=

# Postgres password used by docker-compose for the postgres service and the server's DATABASE_URL
POSTGRES_PASSWORD=

# Local dev only (compose sets DATABASE_URL itself)
# DATABASE_URL=postgres://shopai:password@localhost:5432/shopai

# ZillaAGI (ZAGI): base URL INCLUDES /v1, model pinned
ZAGI_BASE_URL=https://llm.oddin.gg/v1
ZAGI_API_KEY=
ZAGI_MODEL=glm-5.3-flash

# Household
HOUSEHOLD_NAME=Family
TZ=Europe/Amsterdam
NICKNAMES=shopai,шопаи,шоппер,шон

# Runtime
LOG_LEVEL=info
HTTP_HOST=127.0.0.1
HTTP_PORT=3000

# Encrypts store tokens at rest (openssl rand -hex 32). Required to connect Albert Heijn.
SESSION_SECRET=

# Web layer (internet search, page reads, bol.com / Amazon.nl). See docs/WEB.md.
# All optional: with no keys, search falls back to DuckDuckGo (flaky from a
# datacenter IP) and Jina Reader runs unauthenticated (20 reads/min).
WEB_ENABLED=true
WEB_SEARCH_PROVIDERS=brave,serper,jina,duckduckgo
# Brave Search API (free tier: 2000 queries/month) — the reliable option
BRAVE_SEARCH_API_KEY=
# Serper.dev (Google results, free tier 2500 queries)
SERPER_API_KEY=
# Jina Reader / Search key (raises the read rate limit, enables s.jina.ai search)
JINA_API_KEY=
# Residential HTTP(S) proxy for hosts that block datacenter IPs, e.g. http://user:pass@host:port
WEB_PROXY_URL=
WEB_PROXY_HOSTS=bol.com,amazon.nl
# Amazon Associates tag (optional, affiliate attribution on cart links only)
AMAZON_ASSOCIATE_TAG=
