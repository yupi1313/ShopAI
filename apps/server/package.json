{
  "name": "@shopai/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ShopAI runtime: Telegram bot (grammY), agent wiring, HTTP health/web, scheduler",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
