    "@shopai/db": "workspace:*",
    "@shopai/llm": "workspace:*",
    "dotenv": "^16.4.5",
    "fastify": "^5.3.0",
    "grammy": "^1.36.0",
    "pino": "^9.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
