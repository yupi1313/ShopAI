{
  "name": "shopai",
  "version": "0.1.0",
  "private": true,
  "description": "Family grocery and shopping assistant: Telegram + web, ZAGI-powered",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter @shopai/server dev",
    "start": "pnpm --filter @shopai/server start",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
